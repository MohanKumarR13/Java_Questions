public class ExtractNumbersFromStringAndAdd {

     public static void main(String[] args) {

        String str = "abc123xyz4";
        int sum = 0;

        for (int i = 0; i < str.length(); i++) {

            char ch = str.charAt(i);

            if (ch >= '0' && ch <= '9') {

                int digit = ch - '0';

               // System.out.println(digit);

                sum = sum + digit;
            }
        }

        System.out.println("Sum = " + sum);
    }
}
